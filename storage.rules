rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Academy logos uploaded during registration. Owners can upload their own
    // logo; anyone may read it (logos are not sensitive).
    match /academy_logos/{userId}/{file} {
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow read: if true;
    }

    // Secure by default; remaining tenant-scoped storage rules are added in
    // Phase 10.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
