rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // AUTH + FIRESTORE ONLY
    // -------------------------------------------------------------------------
    // Firebase is used for Authentication (email/password) and text data only.
    // A user's role and academy context live in their `users/{uid}` document.
    function isSignedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isSuperAdmin() {
      return isSignedIn()
        && (
          request.auth.token.role == 'super_admin' ||
          request.auth.token.role == 'superAdmin' ||
          request.auth.token.email == 'admin@acadrix.com' ||
          request.auth.token.email == 'admin@acaderix.com' ||
          (exists(userProfile()) && (get(userProfile()).data.role == 'super_admin' || get(userProfile()).data.role == 'superAdmin'))
        );
    }

    // Each signed-in user owns their profile document; Super Admin manages all.
    match /users/{uid} {
      allow read: if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSuperAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isSuperAdmin();
    }

    // Academies: an owner creates/updates their own; Super Admin manages all.
    // Public read allows pre-login verification of academy standing without issuing tokens.
    match /academies/{academyId} {
      allow create: if isSuperAdmin()
        || (isSignedIn() && request.resource.data.ownerUid == request.auth.uid);
      allow read: if true;
      allow update: if isSuperAdmin()
        || (isSignedIn() && resource.data.ownerUid == request.auth.uid);
      allow delete: if isSuperAdmin();

      // Attendance: advance attendance guardrail at database level
      match /attendance/{attendanceId} {
        allow read: if isSuperAdmin()
          || (get(/databases/$(database)/documents/academies/$(academyId)).data.status == 'active');
        allow create, update: if (isSuperAdmin()
          || get(/databases/$(database)/documents/academies/$(academyId)).data.status == 'active')
          && (!('date' in request.resource.data) || request.resource.data.date <= request.time);
        allow delete: if isSuperAdmin();
      }

      // All subcollections under an academy (students, staff, branches, fees, etc.)
      // Enforces active tenant standing: pending or suspended academies are blocked at server level.
      match /{subcollection}/{docId=**} {
        allow read, write, delete: if isSuperAdmin()
          || (
            get(/databases/$(database)/documents/academies/$(academyId)).data.status == 'active'
          );
      }
    }

    // Academy codes map a human-friendly code to an academy id.
    match /academy_codes/{code} {
      allow create: if isSignedIn();
      allow read: if isSignedIn();
      allow delete: if isSuperAdmin();
    }

    // Staff accounts: read allowed for staff login verification; write by signed-in admins.
    match /staff_accounts/{staffId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isSignedIn();
    }

    // Student accounts: read allowed for student portal roll number login lookup; write by signed-in admins.
    match /student_accounts/{accountKey} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin() || isSignedIn();
    }

    // Subscriptions: Super Admin manages all; read permitted for pre-login standing verification.
    match /subscriptions/{subscriptionId} {
      allow read, write, delete: if isSuperAdmin();
      allow read: if true;
    }

    // Subscription Plans: Anyone authenticated can read; Super Admin can manage.
    match /subscription_plans/{planId} {
      allow read: if isSignedIn();
      allow write, delete: if isSuperAdmin();
    }

    // Subscription Payments: Super Admin manages all; Academy Admin can read their own.
    match /subscription_payments/{paymentId} {
      allow read, write, delete: if isSuperAdmin();
      allow read: if isSignedIn()
        && (exists(userProfile()) && resource.data.academyId == get(userProfile()).data.academyId);
    }

    // Platform Broadcasts: Super Admin manages; all authenticated users can read notices.
    match /broadcasts/{broadcastId} {
      allow read, write, delete: if isSuperAdmin();
      allow read: if isSignedIn();
    }

    // Support Tickets: Super Admin manages all; Academy admins can submit and view.
    match /support_tickets/{ticketId} {
      allow read, write, delete: if isSuperAdmin();
      allow read, create, update: if isSignedIn();
    }

    // Platform Settings: Super Admin manages; read permitted to verify maintenance status.
    match /platform_settings/{settingId} {
      allow read, write: if isSuperAdmin();
      allow read: if true;
    }

    // -------------------------------------------------------------------------
    // SECURE BY DEFAULT
    // -------------------------------------------------------------------------
    // Everything else stays locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
